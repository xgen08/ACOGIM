nts/DevisForm.vue","../../../../components/DevisSection.vue"],"sourcesContent":["<script setup>\nconst props = defineProps({\n  title: { type: String, default: 'Demander un devis' },\n  subject: { type: String, default: '' },\n  // Pré-sélection de « Activité concernée » (doit correspondre à une option ci-dessous).\n  activite: { type: String, default: '' }\n})\n\nconst submitted = ref(false)\nconst form = reactive({\n  nom: '',\n  telephone: '',\n  email: '',\n  activite: props.activite,\n  message: ''\n})\n\nfunction handleSubmit() {\n  // Intégration à brancher : API interne, e-mail transactionnel, ou CRM.\n  submitted.value = true\n}\n\nconst label = 'block text-[11px] font-semibold uppercase tracking-[0.15em] text-muted mb-2'\nconst field = 'w-full rounded bg-concrete border border-transparent px-4 py-3 text-[15px] text-noir transition-colors focus:bg-white focus:border-palm focus:outline-none focus:ring-2 focus:ring-palm/30'\n</script>\n\n<template>\n  <div class=\"bg-white rounded p-8 md:p-10 shadow-[0_10px_40px_rgba(0,0,0,0.08)]\">\n    <p class=\"eyebrow mb-2\">{{ subject || 'Formulaire' }}</p>\n    <h3 class=\"font-display text-2xl md:text-3xl font-semibold text-noir mb-8\">{{ title }}</h3>\n\n    <form v-if=\"!submitted\" class=\"space-y-5\" @submit.prevent=\"handleSubmit\">\n      <div class=\"grid sm:grid-cols-2 gap-5\">\n        <div>\n          <label :class=\"label\" for=\"nom\">Nom complet</label>\n          <input id=\"nom\" v-model=\"form.nom\" type=\"text\" required autocomplete=\"name\" :class=\"field\" />\n        </div>\n        <div>\n          <label :class=\"label\" for=\"telephone\">Téléphone</label>\n          <input id=\"telephone\" v-model=\"form.telephone\" type=\"tel\" required autocomplete=\"tel\" :class=\"field\" />\n        </div>\n      </div>\n\n      <div>\n        <label :class=\"label\" for=\"email\">E-mail</label>\n        <input id=\"email\" v-model=\"form.email\" type=\"email\" autocomplete=\"email\" :class=\"field\" />\n      </div>\n\n      <div>\n        <label :class=\"label\" for=\"activite\">Activité concernée</label>\n        <select id=\"activite\" v-model=\"form.activite\" :class=\"field\">\n          <option value=\"\">Sélectionner...</option>\n          <option>Immobilier — achat / vente</option>\n          <option>Construction</option>\n          <option>Maintenance industrielle</option>\n          <option>Sécurité électronique (vidéosurveillance, contrôle d'accès, incendie)</option>\n          <option>Autre</option>\n        </select>\n      </div>\n\n      <div>\n        <label :class=\"label\" for=\"message\">Votre besoin</label>\n        <textarea id=\"message\" v-model=\"form.message\" rows=\"5\" required :class=\"field\"></textarea>\n      </div>\n\n      <button type=\"submit\" class=\"btn-primary w-full sm:w-auto\">Envoyer la demande</button>\n    </form>\n\n    <div v-else class=\"py-6 flex gap-5 items-start\">\n      <span class=\"w-12 h-12 shrink-0 rounded-full bg-palm/20 text-forest flex items-center justify-center\">\n        <svg aria-hidden=\"true\" class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7.5\" /></svg>\n      </span>\n      <div>\n        <p class=\"font-display text-2xl font-semibold text-noir mb-2\">Demande envoyée.</p>\n        <p class=\"text-[15px] leading-[1.7] text-muted\">\n          Un membre de l'équipe ACOGIM-CI revient vers vous sous peu au numéro ou à l'adresse indiqués.\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n","<script setup>\ndefineProps({\n  subject: { type: String, default: '' },\n  title: { type: String, default: 'Demander un devis' },\n  activite: { type: String, default: '' },\n  eyebrow: { type: String, default: 'Demande de devis' },\n  intro: {\n    type: String,\n    default: 'Décrivez-nous votre besoin : nous revenons vers vous pour en discuter et vous proposer un devis.'\n  },\n  // Coordonnées sous le texte (inutiles quand la page les affiche déjà).\n  showContacts: { type: Boolean, default: true }\n})\n</script>\n\n<template>\n  <!-- Section devis : texte et coordonnées à gauche, formulaire à droite. -->\n  <section id=\"devis\" class=\"bg-concrete py-[120px] scroll-mt-16\">\n    <div class=\"mx-auto max-w-[1280px] px-8 grid gap-12 lg:gap-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start\">\n      <div v-reveal=\"{ from: 'left' }\" class=\"lg:sticky lg:top-28\">\n        <p class=\"eyebrow mb-4\">{{ eyebrow }}</p>\n        <h2 class=\"font-display font-semibold text-[clamp(32px,4vw,48px)] leading-[1.15] text-noir mb-6 [&_span]:text-orange [&_span]:italic [&_span]:font-normal\">\n          <slot name=\"title\">Parlons de <span>votre projet.</span></slot>\n        </h2>\n        <p class=\"text-[17px] leading-[1.9] text-muted max-w-[460px]\">{{ intro }}</p>\n\n        <ul v-if=\"showContacts\" class=\"mt-10 space-y-5 text-[15px]\">\n          <li class=\"flex items-center gap-4\">\n            <span class=\"w-10 h-10 shrink-0 rounded-full bg-palm/20 text-forest flex items-center justify-center\">\n              <svg aria-hidden=\"true\" class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2\" /></svg>\n            </span>\n            <span class=\"flex flex-col\">\n              <span class=\"text-[11px] font-semibold uppercase tracking-[0.15em] text-muted\">M. YEO Nandielè</span>\n              <span>\n                <a href=\"tel:+2250707000207\" class=\"text-noir hover:text-ember transition-colors\">+225 07 07 00 02 07</a>\n                <span class=\"text-muted\"> · </span>\n                <a href=\"tel:+2250105000150\" class=\"text-noir hover:text-ember transition-colors\">+225 01 05 00 01 50</a>\n              </span>\n            </span>\n          </li>\n          <li class=\"flex items-center gap-4\">\n            <span class=\"w-10 h-10 shrink-0 rounded-full bg-palm/20 text-forest flex items-center justify-center\">\n              <AppIcon name=\"map-pin\" class=\"w-5 h-5\" />\n            </span>\n            <span class=\"flex flex-col\">\n              <span class=\"text-[11px] font-semibold uppercase tracking-[0.15em] text-muted\">Agence</span>\n              <a href=\"tel:+2252724451422\" class=\"text-noir hover:text-ember transition-colors\">+225 27 24 45 14 22</a>\n            </span>\n          </li>\n        </ul>\n      </div>\n\n      <div v-reveal=\"{ from: 'right', delay: 150 }\">\n        <DevisForm :subject=\"subject\" :title=\"title\" :activite=\"activite\" />\n      </div>\n    </div>\n  </section>\n</template>\n"],"version":3}