1D,CAAyG,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAAlB,SAAO;AAAA,YAAA;AAAA;;;;;QACpF,IAAG;AAAA,QAAoB,qBAAO,KAAA,QAAI;AAAA,QAAU,sBAAmB;AAAA,MAAA;yBAAzE,CAAgI,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAA1B,iBAAe;AAAA,YAAA;AAAA;;;;;AAC/FI,oBAAA,YAAL,MAAC;;UAAgB,KAAK,EAAE;AAAA,UAAK,IAAI,EAAE;AAAA,UAAK,qBAAO,KAAA,QAAI;AAAA,UAAU,OAAM;AAAA,UAAkB,sBAAmB;AAAA,QAAA;2BAAzH,CAEW,GAAAL,QAAAC,UAAA,aAAA;;AADND,qBAAA,GAAAM,eAAA,EAAE,KAAK,CAAA,EAAA;AAAA;;gBAAPC,gBAAAC,gBAAA,EAAE,KAAK,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;;;QAEF,IAAG;AAAA,QAAiB,qBAAO,KAAA,QAAI;AAAA,QAAU,sBAAmB;AAAA,MAAA;yBAAtE,CAA0H,GAAAR,QAAAC,UAAA,aAAA;;;;;8BAAvB,cAAY;AAAA,YAAA;AAAA;;;;;QACrG,IAAG;AAAA,QAAc,qBAAO,KAAA,QAAI;AAAA,QAAU,sBAAmB;AAAA,MAAA;yBAAnE,CAAoH,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAApB,WAAS;AAAA,YAAA;AAAA;;;;;QAC/F,IAAG;AAAA,QAAY,qBAAO,KAAA,QAAI;AAAA,QAAU,OAAM;AAAA,QAA2B,sBAAmB;AAAA,MAAA;yBAAlG,CAA0J,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAzB,gBAAc;AAAA,YAAA;AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;uBClG5IQ,eAAAC,WAAA,EAAA,OAAM,2IAA0I,GAAA,MAAA,CAAA,kMAGxID,eAAAC,WAAA,EAAA,OAAM,6EAA4E,GAAAC,qBAAA,MAAA,iBAAA,CAAA,CAAA,oBAAI,QAAA,KAAK,uCACtF,OAAM,mDAAkD,GAAAA,qBAAA,MAAA,mBAA7D,GAAG,CAAA,CAAA,oBAA8D,QAAA,IAAI;;QACxD,IAAI,QAAA;AAAA,QAAI,OAAM;AAAA,uDAApB,GAAG,CAAA,GAAA;AAAA,yBAAvB,CAAyE,GAAAX,QAAAC,UAAA,aAAA;;qCAAnB,QAAA,KAAK,CAAA,EAAA;AAAA;;8CAAL,QAAA,KAAK,GAAA,CAAA;AAAA;;;;;;;;;;;;;;;;;;;ACJjE,UAAM,aAAa;AAAA,MACjB,oBAAoB;AAAA,QAClB,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,OAAO;AAAA,MACX;AAAA,MACE,yBAAyB;AAAA,QACvB,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,OAAO;AAAA,MACX;AAAA,MACE,2BAA2B;AAAA,QACzB,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,OAAO;AAAA,MACX;AAAA,MACE,uCAAuC;AAAA,QACrC,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,OAAO;AAAA,MACX;AAAA,MACE,iBAAiB;AAAA,QACf,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,OAAO;AAAA,MACX;AAAA,MACE,cAAc;AAAA,QACZ,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,OAAO;AAAA,MACX;AAAA,MACE,YAAY;AAAA,QACV,OAAO;AAAA,QACP,MAAM;AAAA,QACN,IAAI;AAAA,QACJ,OAAO;AAAA,MACX;AAAA,IACA;AAEA,UAAM,QAAQ,SAAQ;AACtB,UAAM,MAAM,SAAS,MAAM,WAAW,MAAM,KAAK,QAAQ,OAAO,EAAE,KAAK,GAAG,KAAK,CAAA,CAAE;;;;;qDAK5DF,MAAA,GAAA,GAAG,MAAA,OAAA,CAAA;;;QAoCE,IAAG;AAAA,QAAwB,OAAM;AAAA;yBAA3C,CAAoG,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAArB,YAAU;AAAA;;;;;;;QAC/E,IAAG;AAAA,QAA0B,OAAM;AAAA;yBAA7C,CAAwG,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAvB,cAAY;AAAA;;;;;;;QACnF,IAAG;AAAA,QAAsC,OAAM;AAAA;yBAAzD,CAAgI,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAnC,0BAAwB;AAAA;;;;;;;QAC3G,IAAG;AAAA,QAAW,OAAM;AAAA;yBAA9B,CAAoF,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAAlB,SAAO;AAAA;;;;;AAMrE,YAAA,oJAAAK,gBAAA,oBAAA,KAAI,GAAG,YAAW,CAAA,CAAA,yGAAA;AAAA;;;;;;;;;;;;;ACnG/B,QAAA,OAAAG,eAAAC,WAAA,EAAA,OAAM,gCAA4B,MAAA,CAAA,CAAA,GAAA;;;;;;;;;;;;;;;","names":["_unref","_push","_parent","_ssrRenderAttr","asset","_createVNode","_ssrRenderList","_ssrInterpolate","_createTextVNode","_toDisplayString","_ssrRenderAttrs","_mergeProps","_ssrGetDirectiveProps"],"sources":["../../../../components/TheHeader.vue","../../../../components/CtaBanner.vue","../../../../components/TheFooter.vue","../../../../layouts/default.vue"],"sourcesContent":["<script setup>\nconst open = ref(false)\nconst activitesOpen = ref(false)\nconst scrolled = ref(false)\n\nconst activites = [\n  { label: 'Immobilier', to: '/activites/immobilier' },\n  { label: 'Construction', to: '/activites/construction' },\n  { label: 'Maintenance industrielle', to: '/activites/maintenance-industrielle' }\n]\n\nfunction onScroll() {\n  scrolled.value = window.scrollY > 40\n}\n\nonMounted(() => {\n  window.addEventListener('scroll', onScroll, { passive: true })\n  onScroll()\n})\n\nonUnmounted(() => {\n  window.removeEventListener('scroll', onScroll)\n})\n\n// Lien de navigation : gris, soulignement vert qui se déploie au survol.\nconst underline = \"relative transition-colors after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-px after:w-0 after:bg-palm after:transition-all after:duration-300 hover:after:w-full\"\nconst navLink = `${underline} text-muted hover:text-noir`\n// Page en cours : texte noir et soulignement plein (classe posée par NuxtLink).\nconst navActive = '!text-noir after:!w-full after:!h-0.5'\n\nconst route = useRoute()\nconst surActivite = computed(() => route.path.startsWith('/activites'))\n</script>\n\n<template>\n  <header\n    class=\"sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-black/5 transition-shadow duration-300\"\n    :class=\"scrolled ? 'shadow-[0_10px_30px_rgba(0,0,0,0.05)]' : ''\"\n  >\n    <div class=\"mx-auto max-w-[1280px] px-8\">\n      <div\n        class=\"flex items-center justify-between transition-[height] duration-300\"\n        :class=\"scrolled ? 'h-16' : 'h-20'\"\n      >\n        <NuxtLink to=\"/\" class=\"flex items-center\">\n          <img\n            :src=\"asset('/images/logo/acogim-icon.png')\"\n            alt=\"ACOGIM-CI\"\n            class=\"w-auto transition-[height] duration-300\"\n            :class=\"scrolled ? 'h-9' : 'h-12'\"\n          >\n        </NuxtLink>\n\n        <!-- Desktop nav -->\n        <nav class=\"hidden md:flex items-center gap-10 text-sm font-medium\">\n          <NuxtLink to=\"/\" :class=\"navLink\" :exact-active-class=\"navActive\">Accueil</NuxtLink>\n          <NuxtLink to=\"/qui-sommes-nous\" :class=\"navLink\" :exact-active-class=\"navActive\">Qui sommes-nous</NuxtLink>\n\n          <div class=\"relative\" @mouseenter=\"activitesOpen = true\" @mouseleave=\"activitesOpen = false\">\n            <button class=\"flex items-center gap-1\" :class=\"[navLink, surActivite && navActive]\" :aria-expanded=\"activitesOpen\">\n              Nos activités\n              <span class=\"text-xs\">▾</span>\n            </button>\n            <div\n              v-show=\"activitesOpen\"\n              class=\"absolute left-0 top-full pt-4 w-64\"\n            >\n              <ul class=\"bg-white border border-black/5 shadow-[0_20px_60px_rgba(0,0,0,0.08)]\">\n                <li v-for=\"a in activites\" :key=\"a.to\">\n                  <NuxtLink :to=\"a.to\" class=\"block px-5 py-3 text-sm text-charcoal hover:bg-concrete hover:text-forest transition-colors\" exact-active-class=\"bg-concrete !text-forest font-semibold\">\n                    {{ a.label }}\n                  </NuxtLink>\n                </li>\n              </ul>\n            </div>\n          </div>\n\n          <NuxtLink to=\"/realisations\" :class=\"navLink\" :exact-active-class=\"navActive\">Réalisations</NuxtLink>\n          <NuxtLink to=\"/catalogue\" :class=\"navLink\" :exact-active-class=\"navActive\">Catalogue</NuxtLink>\n          <NuxtLink to=\"/contact\" :class=\"`${underline} font-semibold text-ember hover:text-orange`\" exact-active-class=\"after:!w-full after:!h-0.5\">Nous contacter</NuxtLink>\n        </nav>\n\n        <!-- Mobile toggle -->\n        <button class=\"md:hidden p-2 -mr-2\" @click=\"open = !open\" :aria-expanded=\"open\" aria-label=\"Ouvrir le menu\">\n          <span class=\"block w-6 h-px bg-noir mb-1.5\"></span>\n          <span class=\"block w-6 h-px bg-noir mb-1.5\"></span>\n          <span class=\"block w-6 h-px bg-noir\"></span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Mobile nav -->\n    <div v-show=\"open\" class=\"md:hidden bg-white border-t border-black/5\">\n      <nav class=\"flex flex-col px-8 py-5 gap-4 text-sm font-medium text-charcoal\">\n        <NuxtLink to=\"/\" @click=\"open = false\" exact-active-class=\"!text-forest font-semibold\">Accueil</NuxtLink>\n        <NuxtLink to=\"/qui-sommes-nous\" @click=\"open = false\" exact-active-class=\"!text-forest font-semibold\">Qui sommes-nous</NuxtLink>\n        <NuxtLink v-for=\"a in activites\" :key=\"a.to\" :to=\"a.to\" @click=\"open = false\" class=\"pl-4 text-muted\" exact-active-class=\"!text-forest font-semibold\">\n          {{ a.label }}\n        </NuxtLink>\n        <NuxtLink to=\"/realisations\" @click=\"open = false\" exact-active-class=\"!text-forest font-semibold\">Réalisations</NuxtLink>\n        <NuxtLink to=\"/catalogue\" @click=\"open = false\" exact-active-class=\"!text-forest font-semibold\">Catalogue</NuxtLink>\n        <NuxtLink to=\"/contact\" @click=\"open = false\" class=\"font-semibold text-ember\" exact-active-class=\"underline underline-offset-4\">Nous contacter</NuxtLink>\n      </nav>\n    </div>\n  </header>\n</template>\n","<template>\n  <!-- Bandeau d'appel final : vert lime atténué qui part du gris clair de la\n       section précédente, puis vague noire vers le pied de page. -->\n  <section class=\"relative overflow-hidden bg-gradient-to-b from-concrete via-palm/50 to-palm/70 text-noir pt-[100px] pb-[160px] md:pb-[190px] text-center\">\n    <div class=\"absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.4),transparent_60%)]\"></div>\n    <div class=\"relative mx-auto max-w-[1280px] px-8\">\n      <h2 v-reveal class=\"font-display font-semibold text-[clamp(32px,4vw,48px)] leading-[1.15] mb-5\">{{ title }}</h2>\n      <p v-reveal=\"120\" class=\"text-lg max-w-[600px] mx-auto mb-10 text-noir/80\">{{ text }}</p>\n      <NuxtLink v-reveal=\"240\" :to=\"to\" class=\"btn-dark\">{{ label }}</NuxtLink>\n    </div>\n\n    <svg\n      aria-hidden=\"true\"\n      class=\"absolute bottom-0 left-0 w-full h-[70px] md:h-[100px]\"\n      viewBox=\"0 0 1440 100\"\n      preserveAspectRatio=\"none\"\n    >\n      <path d=\"M0 40 C 260 95, 520 95, 760 55 S 1180 0, 1440 45 L1440 100 L0 100 Z\" fill=\"#0F0F0F\" fill-opacity=\"0.25\" />\n      <path d=\"M0 70 C 300 20, 560 20, 820 60 S 1220 105, 1440 55 L1440 100 L0 100 Z\" fill=\"#0F0F0F\" />\n    </svg>\n  </section>\n</template>\n\n<script setup>\ndefineProps({\n  title: { type: String, default: 'Un projet immobilier ou industriel en tête ?' },\n  text: {\n    type: String,\n    default: 'Parcourez notre catalogue de biens et services, ou décrivez-nous directement votre besoin.'\n  },\n  to: { type: String, default: '/catalogue' },\n  label: { type: String, default: 'Parcourir le catalogue →' }\n})\n</script>\n","<script setup>\n// Bandeau d'appel adapté à chaque page. Les pages qui ont déjà un formulaire\n// de devis renvoient vers la suite logique plutôt que vers un second devis.\n// Une page absente de la liste reçoit le bandeau par défaut (celui de l'accueil).\nconst ctaParPage = {\n  '/qui-sommes-nous': {\n    title: 'Trois métiers, une seule exigence.',\n    text: \"Découvrez les projets que nous avons livrés, ceux en cours et ceux à venir.\",\n    to: '/realisations',\n    label: 'Voir nos réalisations →'\n  },\n  '/activites/immobilier': {\n    title: 'Un bien en vue ?',\n    text: 'Villas, terrains : parcourez les biens disponibles dans notre catalogue.',\n    to: '/catalogue',\n    label: 'Voir les biens disponibles →'\n  },\n  '/activites/construction': {\n    title: 'Nos chantiers parlent pour nous.',\n    text: 'Résidences livrées, projets en cours et à venir : découvrez nos réalisations.',\n    to: '/realisations',\n    label: 'Voir nos réalisations →'\n  },\n  '/activites/maintenance-industrielle': {\n    title: 'Entretenir et sécuriser votre site ?',\n    text: 'Contrat de maintenance, vidéosurveillance, détection incendie : toutes nos offres sont sur devis.',\n    to: '/catalogue',\n    label: 'Voir les offres du catalogue →'\n  },\n  '/realisations': {\n    title: 'Votre projet pourrait être le prochain.',\n    text: 'Construction, bien immobilier ou site industriel : décrivez-nous votre besoin.',\n    to: '/contact',\n    label: 'Parler de votre projet →'\n  },\n  '/catalogue': {\n    title: \"Besoin d'un conseil avant de choisir ?\",\n    text: \"Découvrez l'agence, nos trois métiers et la manière dont nous suivons chaque projet.\",\n    to: '/qui-sommes-nous',\n    label: \"Découvrir l'agence →\"\n  },\n  '/contact': {\n    title: 'Pas encore tout à fait décidé ?',\n    text: 'Parcourez notre catalogue de biens et services pour préciser votre besoin.',\n    to: '/catalogue',\n    label: 'Parcourir le catalogue →'\n  }\n}\n\nconst route = useRoute()\nconst cta = computed(() => ctaParPage[route.path.replace(/\\/$/, '') || '/'] ?? {})\n</script>\n\n<template>\n  <!-- Bandeau d'appel (vague) + pied de page, affichés sur toutes les pages via layouts/default.vue -->\n  <CtaBanner v-bind=\"cta\" />\n  <footer class=\"bg-noir text-white pt-24 pb-10\">\n    <div class=\"mx-auto max-w-[1280px] px-8\">\n      <div class=\"grid gap-14 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] mb-20\">\n        <div>\n          <p class=\"font-display text-2xl font-bold tracking-[-0.03em] mb-6\">\n            ACOGIM<span class=\"text-palm\">-CI</span>\n          </p>\n          <p class=\"text-[15px] leading-[1.8] text-white/60 max-w-[300px]\">\n            Agence de Construction, de Gestion Immobilières et de Maintenance\n            Côte d'Ivoire.\n          </p>\n        </div>\n\n        <div>\n          <h4 class=\"font-body text-xs font-semibold uppercase tracking-[0.15em] mb-7\">Coordonnées</h4>\n          <ul class=\"space-y-4 text-sm text-white/60\">\n            <li>BP : 705 CIDEX 03 Abidjan</li>\n            <li>Ayopoumin Ex-Mittérand, Villa n° 356</li>\n            <li>Bingerville</li>\n            <li><a href=\"tel:+2252724451422\" class=\"hover:text-palm transition-colors\">+225 27 24 45 14 22</a></li>\n          </ul>\n        </div>\n\n        <div>\n          <h4 class=\"font-body text-xs font-semibold uppercase tracking-[0.15em] mb-7\">Contact projet</h4>\n          <ul class=\"space-y-4 text-sm text-white/60\">\n            <li>M. YEO Nandielè</li>\n            <li><a href=\"tel:+2250707000207\" class=\"hover:text-palm transition-colors\">+225 07 07 00 02 07</a></li>\n            <li><a href=\"tel:+2250105000150\" class=\"hover:text-palm transition-colors\">+225 01 05 00 01 50</a></li>\n          </ul>\n        </div>\n\n        <div>\n          <h4 class=\"font-body text-xs font-semibold uppercase tracking-[0.15em] mb-7\">Navigation</h4>\n          <ul class=\"space-y-4 text-sm text-white/60\">\n            <li><NuxtLink to=\"/activites/immobilier\" class=\"hover:text-palm transition-colors\">Immobilier</NuxtLink></li>\n            <li><NuxtLink to=\"/activites/construction\" class=\"hover:text-palm transition-colors\">Construction</NuxtLink></li>\n            <li><NuxtLink to=\"/activites/maintenance-industrielle\" class=\"hover:text-palm transition-colors\">Maintenance industrielle</NuxtLink></li>\n            <li><NuxtLink to=\"/contact\" class=\"hover:text-palm transition-colors\">Contact</NuxtLink></li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"border-t border-white/10 pt-10 flex flex-col md:flex-row gap-4 justify-between text-[13px] text-white/50\">\n        <p>© {{ new Date().getFullYear() }} ACOGIM-CI. Tous droits réservés.</p>\n        <p>Bingerville, Côte d'Ivoire</p>\n      </div>\n    </div>\n  </footer>\n</template>\n","<template>\n  <div class=\"min-h-screen flex flex-col\">\n    <TheHeader />\n    <main class=\"flex-1\">\n      <slot />\n    </main>\n    <TheFooter />\n  </div>\n</template>\n"],"version":3}